# Gold Price API Configuration
# Copy this file to .env.local and add your API keys

# ========================================
# GOLD PRICE APIs (FREE TIERS AVAILABLE)
# ========================================

# 1. GoldAPI.io (Primary - 1000 requests/month FREE)
# Sign up: https://www.goldapi.io/dashboard
# Free tier: 1000 requests/month, real-time prices
NEXT_PUBLIC_GOLD_API_KEY=your_goldapi_key_here

# 2. MetalpriceAPI.com (Secondary - 100 requests/month FREE)
# Sign up: https://metalpriceapi.com/
# Free tier: 100 requests/month
NEXT_PUBLIC_METAL_PRICE_API_KEY=your_metalpriceapi_key_here

# 3. CoinGecko (Third fallback - NO API KEY REQUIRED)
# 100% FREE, no signup needed
# Uses PAX Gold (PAXG) cryptocurrency backed 1:1 by physical gold
# No configuration needed - works out of the box!

# ========================================
# HOW TO GET FREE API KEYS
# ========================================

# GoldAPI.io (Recommended - Best free tier):
# 1. Visit https://www.goldapi.io/
# 2. Click "Get API Key" or "Sign Up"
# 3. Create free account (no credit card required)
# 4. Copy your API key from dashboard
# 5. Paste it above as NEXT_PUBLIC_GOLD_API_KEY

# MetalpriceAPI.com (Fallback):
# 1. Visit https://metalpriceapi.com/
# 2. Click "Get Free API Key"
# 3. Sign up with email
# 4. Copy API key from dashboard
# 5. Paste it above as NEXT_PUBLIC_METAL_PRICE_API_KEY

# ========================================
# USAGE LIMITS (FREE TIERS)
# ========================================

# GoldAPI.io:
#   - 1000 requests/month
#   - Real-time spot prices
#   - Updates every 60 seconds
#   - No credit card required

# MetalpriceAPI.com:
#   - 100 requests/month
#   - Real-time metal prices
#   - No credit card required

# CoinGecko:
#   - NO LIMITS (public API)
#   - No API key needed
#   - Always available as fallback
#   - Uses PAXG token (1:1 backed by gold)

# ========================================
# AUTO-UPDATE STRATEGY
# ========================================

# System fetches price every 1 hour:
# - First tries GoldAPI (1000/month = 720/month for hourly)
# - If that fails, tries MetalpriceAPI (100/month = good for 4 days)
# - If that fails, uses CoinGecko (unlimited, always works)
# - If all fail, manual entry required

# With hourly updates (24 requests/day):
# - GoldAPI covers ~41 days
# - MetalpriceAPI covers ~4 days as backup
# - CoinGecko covers infinite days as final fallback

# ========================================
# FIREBASE CONFIGURATION
# ========================================

NEXT_PUBLIC_COMPANY_ID=goldsmith
